diff --git a/build/get_dependencies.py b/build/get_dependencies.py
index 43ba621..417f875 100644
--- a/build/get_dependencies.py
+++ b/build/get_dependencies.py
@@ -491,6 +491,18 @@ def configure_cmake(name, cmake_layers, platform, cmake, vs_version, ndk_path,
     make_dir(install_dir)
 
     cmake_args = []
+    # Steam Audio pins some dependency revisions whose cmake_minimum_required
+    # predates CMake 3.5. CMake 4 can still build them when the policy floor is
+    # stated explicitly.
+    cmake_args += ['-DCMAKE_POLICY_VERSION_MINIMUM=3.5']
+    if platform.startswith('windows-'):
+        # Ensure old dependency projects honor CMAKE_MSVC_RUNTIME_LIBRARY.
+        # Otherwise libmysofa silently uses /MD while Steam Audio uses /MT.
+        cmake_args += ['-DCMAKE_POLICY_DEFAULT_CMP0091=NEW']
+    if platform.startswith('linux-'):
+        # Old FlatBuffers treats warnings as errors and GCC 16 diagnoses one
+        # additional unused variable in its code generator.
+        cmake_args += ['-DCMAKE_CXX_FLAGS=-Wno-error=unused-but-set-variable']
 
     if platform == 'windows-x86':
         cmake_args += ['-G', vs_generator_name(vs_version), '-A', 'Win32']
