diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0f8fe97..37b3dbf 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -163,6 +163,9 @@ if (IPL_OS_LINUX)
         add_compile_options(-m32 -mfpmath=sse -march=native)
     endif()
     if (STEAMAUDIO_ENABLE_AVX)
-        add_compile_options(-fabi-version=6)
+        # The public library boundary is C. Forcing GCC's obsolete C++ ABI v6
+        # breaks libstdc++ <future> on GCC 11, including Ubuntu 22.04 CI, and
+        # provides no compatibility benefit to API consumers.
+        # add_compile_options(-fabi-version=6)
     endif()
 endif()
