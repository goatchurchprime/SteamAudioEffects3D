[configuration]
entry_symbol = "steam_spatial_library_init"
compatibility_minimum = "4.6"
reloadable = true

[dependencies]
linux.debug.x86_64 = { "./bin/linux-x86_64/libphonon.so": "" }
linux.release.x86_64 = { "./bin/linux-x86_64/libphonon.so": "" }
linux.debug.arm64 = { "./bin/linux-arm64/libphonon.so": "" }
linux.release.arm64 = { "./bin/linux-arm64/libphonon.so": "" }
windows.debug.x86_64 = { "./bin/windows-x86_64/phonon.dll": "" }
windows.release.x86_64 = { "./bin/windows-x86_64/phonon.dll": "" }
macos.debug = { "./bin/macos/libphonon.dylib": "" }
macos.release = { "./bin/macos/libphonon.dylib": "" }
android.debug.arm64 = { "./bin/android-arm64/libphonon.so": "" }
android.release.arm64 = { "./bin/android-arm64/libphonon.so": "" }

[libraries]
linux.debug.x86_64 = "./bin/linux-x86_64/libsteam_spatial.linux.template_debug.x86_64.so"
linux.release.x86_64 = "./bin/linux-x86_64/libsteam_spatial.linux.template_release.x86_64.so"
linux.debug.arm64 = "./bin/linux-arm64/libsteam_spatial.linux.template_debug.arm64.so"
linux.release.arm64 = "./bin/linux-arm64/libsteam_spatial.linux.template_release.arm64.so"
windows.debug.x86_64 = "./bin/windows-x86_64/libsteam_spatial.windows.template_debug.x86_64.dll"
windows.release.x86_64 = "./bin/windows-x86_64/libsteam_spatial.windows.template_release.x86_64.dll"
macos.debug = "./bin/macos/libsteam_spatial.macos.template_debug.universal.dylib"
macos.release = "./bin/macos/libsteam_spatial.macos.template_release.universal.dylib"
android.debug.arm64 = "./bin/android-arm64/libsteam_spatial.android.template_debug.arm64.so"
android.release.arm64 = "./bin/android-arm64/libsteam_spatial.android.template_release.arm64.so"
